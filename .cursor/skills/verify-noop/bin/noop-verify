#!/usr/bin/env bash
# noop-verify: Control CLI for NoopLocalAccess verification skill
# Exit codes: 0=PASS, 1=FAIL, 2=INCONCLUSIVE

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
BIN_PATH="$REPO_ROOT/Packages/NoopLocalAccess/.build/debug/noop-local-access"
PACKAGE_PATH="$REPO_ROOT/Packages/NoopLocalAccess"

usage() {
    cat <<EOF
Usage: noop-verify <command> [options]

Commands:
  doctor                     Build and smoke-test the CLI
  version                    Print CLI version
  list-tools                 List available tools
  data-freshness             Test data_freshness with temp DB
    --db-path PATH           Use specified database path
  cleanup RUN_ID             Remove temp files for run

Exit codes:
  0  PASS
  1  FAIL (product defect)
  2  INCONCLUSIVE (missing Swift or cannot build)
EOF
}

check_swift() {
    if ! command -v swift &>/dev/null; then
        echo "INCONCLUSIVE: swift not found on PATH" >&2
        exit 2
    fi
}

build_cli() {
    echo "Building noop-local-access..." >&2
    local build_args=(--package-path "$PACKAGE_PATH" --product noop-local-access)
    
    # If SQLITE_SNAPSHOT_DIR is set, add linker flags for snapshot-enabled SQLite
    if [[ -n "${SQLITE_SNAPSHOT_DIR:-}" ]]; then
        build_args+=(-Xcc -I"$SQLITE_SNAPSHOT_DIR" -Xlinker -L"$SQLITE_SNAPSHOT_DIR")
        echo "Using snapshot-enabled SQLite from $SQLITE_SNAPSHOT_DIR" >&2
    fi
    
    if ! swift build "${build_args[@]}" 2>&1; then
        echo "FAIL: swift build failed" >&2
        exit 1
    fi
}

ensure_binary() {
    if [[ ! -f "$BIN_PATH" ]]; then
        echo "Binary not found, building..." >&2
        build_cli
    fi
    
    if [[ ! -f "$BIN_PATH" ]]; then
        echo "FAIL: binary does not exist after build" >&2
        exit 1
    fi
}

cmd_doctor() {
    echo "=== Doctor: NoopLocalAccess CLI ===" >&2
    
    # Check 1: Swift available
    echo -n "Checking swift... " >&2
    if ! command -v swift &>/dev/null; then
        echo "MISSING" >&2
        echo "INCONCLUSIVE: Swift 5.9+ required" >&2
        exit 2
    fi
    swift --version | head -1 >&2
    
    # Check 2: Build succeeds
    echo -n "Building... " >&2
    local build_args=(--package-path "$PACKAGE_PATH" --product noop-local-access)
    
    # If SQLITE_SNAPSHOT_DIR is set, add linker flags for snapshot-enabled SQLite
    if [[ -n "${SQLITE_SNAPSHOT_DIR:-}" ]]; then
        build_args+=(-Xcc -I"$SQLITE_SNAPSHOT_DIR" -Xlinker -L"$SQLITE_SNAPSHOT_DIR")
    fi
    
    if ! swift build "${build_args[@]}" >/dev/null 2>&1; then
        echo "FAILED" >&2
        echo "FAIL: build failed" >&2
        swift build "${build_args[@]}" 2>&1 | tail -20 >&2
        exit 1
    fi
    echo "OK" >&2
    
    # Check 3: Binary exists
    echo -n "Binary exists... " >&2
    if [[ ! -f "$BIN_PATH" ]]; then
        echo "MISSING" >&2
        echo "FAIL: binary not found at $BIN_PATH" >&2
        exit 1
    fi
    echo "OK" >&2
    
    # Check 4: --version works
    echo -n "Version output... " >&2
    VERSION_OUT=$("$BIN_PATH" --version 2>&1 || true)
    if [[ -z "$VERSION_OUT" ]]; then
        echo "EMPTY" >&2
        echo "FAIL: --version produced no output" >&2
        exit 1
    fi
    echo "OK ($VERSION_OUT)" >&2
    
    # Check 5: query --list-tools works
    echo -n "List tools... " >&2
    if ! LIST_OUT=$("$BIN_PATH" query --list-tools 2>&1); then
        echo "FAILED" >&2
        echo "FAIL: query --list-tools failed" >&2
        echo "$LIST_OUT" >&2
        exit 1
    fi
    
    # Validate JSON array
    if ! echo "$LIST_OUT" | python3 -m json.tool >/dev/null 2>&1; then
        echo "INVALID JSON" >&2
        echo "FAIL: query --list-tools output is not valid JSON" >&2
        echo "$LIST_OUT" >&2
        exit 1
    fi
    
    TOOL_COUNT=$(echo "$LIST_OUT" | python3 -c "import sys, json; print(len(json.load(sys.stdin)))")
    echo "OK ($TOOL_COUNT tools)" >&2
    
    echo "" >&2
    echo "PASS: All doctor checks succeeded" >&2
    exit 0
}

cmd_version() {
    check_swift
    ensure_binary
    "$BIN_PATH" --version
}

cmd_list_tools() {
    check_swift
    ensure_binary
    "$BIN_PATH" query --list-tools
}

cmd_data_freshness() {
    check_swift
    ensure_binary
    
    local db_path=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --db-path)
                db_path="$2"
                shift 2
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 64
                ;;
        esac
    done
    
    if [[ -z "$db_path" ]]; then
        echo "Error: --db-path required" >&2
        exit 64
    fi
    
    "$BIN_PATH" query data_freshness --db-path "$db_path"
}

cmd_cleanup() {
    local run_id="${1:-}"
    if [[ -z "$run_id" ]]; then
        echo "Error: cleanup requires RUN_ID" >&2
        exit 64
    fi
    
    local temp_dir="/tmp/noop-verify-$run_id"
    if [[ -d "$temp_dir" ]]; then
        echo "Removing $temp_dir" >&2
        rm -rf "$temp_dir"
    else
        echo "Nothing to clean for run $run_id" >&2
    fi
}

# Main dispatch
case "${1:-}" in
    doctor)
        cmd_doctor
        ;;
    version)
        shift
        cmd_version "$@"
        ;;
    list-tools)
        shift
        cmd_list_tools "$@"
        ;;
    data-freshness)
        shift
        cmd_data_freshness "$@"
        ;;
    cleanup)
        shift
        cmd_cleanup "$@"
        ;;
    --help|-h|help|"")
        usage
        exit 0
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 64
        ;;
esac
